DATABASE_URL=postgresql://user:password@localhost:5432/cci_techapp
JWT_SECRET=change_this_to_a_long_random_string
PORT=3000

# R2 (before/after photo storage) — leave blank until R2 is enabled on the
# Cloudflare account; photo presign requests fail with a clear error until
# these are set, everything else works fine without them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cci-techapp-photos
